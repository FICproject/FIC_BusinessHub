# FIC Business Hub Backend Environment Variables
# Copy this file to .env and fill in real credentials. NEVER commit .env!

NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/fic_business_hub

# JWT Authentication Secrets (replace with long random strings in production)
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
JWT_ADMIN_SECRET=replace_with_long_random_admin_secret
DOCUMENT_SIGNING_SECRET=replace_with_long_random_document_signing_secret

# CORS Origins
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Razorpay Payment Gateway (TEST MODE credentials)
# Keep RAZORPAY_KEY_SECRET strictly on the backend and out of git.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_test_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret
RAZORPAY_ALLOW_LIVE=false

# Private Document Object Storage
# Set OBJECT_STORAGE_PROVIDER=s3 and bucket credentials to use AWS S3 / Cloudflare R2 / Supabase Storage.
# When omitted, files are securely stored in private local disk outside /uploads (apps/backend/storage/private).
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
DOCUMENT_MAX_UPLOAD_BYTES=15728640
