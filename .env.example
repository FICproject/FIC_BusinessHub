# Server Configuration
NODE_ENV=development
PORT=5000

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/fic_business_hub
REDIS_URL=redis://localhost:6379

# Authentication & JWT
JWT_ACCESS_SECRET=fic_business_hub_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=fic_business_hub_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Origins (CORS)
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Payment Gateway
PAYMENT_PROVIDER_KEY=rzp_test_placeholder_key
PAYMENT_PROVIDER_SECRET=placeholder_secret
PAYMENT_WEBHOOK_SECRET=placeholder_webhook_secret

# Object Storage
OBJECT_STORAGE_BUCKET=fic-business-hub-uploads
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ACCESS_KEY=placeholder_access_key
OBJECT_STORAGE_SECRET_KEY=placeholder_secret_key

# Notifications & Comms
EMAIL_PROVIDER_API_KEY=placeholder_email_key
EMAIL_FROM=support@ficapp.in
SMS_PROVIDER_API_KEY=placeholder_sms_key

